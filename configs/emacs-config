(setq browse-url-browser-function 'browse-url-default-browser)
(setq browse-url-generic-program "firefox")

(require 'url-util)

(defun my/search-web ()
  "Search the web for the active region or a prompted query."
  (interactive)
  (let ((query (if (use-region-p)
                   (buffer-substring-no-properties (region-beginning) (region-end))
                 (read-string "Search Firefox: "))))
    (browse-url-firefox (concat "https://duckduckgo.com/?q=" (url-hexify-string query)))))


