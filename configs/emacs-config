;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ps_mem
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

(defun my/run-ps-mem ()
  "Run ps_mem as root and collapse Nix store paths."
  (interactive)
  (let* ((buf (get-buffer-create "*ps_mem*"))
         (ps-mem-bin (executable-find "ps_mem")))
    
    (unless ps-mem-bin
      (error "Emacs cannot find ps_mem. Make sure it is installed in your Nix environment!"))

    (let* ((default-directory "/sudo::/")
           (process (start-file-process-shell-command "ps_mem" buf ps-mem-bin)))
      
      (display-buffer buf)
      
      (set-process-sentinel
       process
       (lambda (proc event)
         (when (string-match-p "finished" event)
           (with-current-buffer (process-buffer proc)
             (let ((inhibit-read-only t))
               (save-excursion
                 (goto-char (point-min))
                 (while (re-search-forward "/nix/store/[a-z0-9]+-\\([^/]+\\)/" nil t)
                   (replace-match "[\\1]/")))))))))))


